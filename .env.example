POSTGRES_DB=stockflow
POSTGRES_TEST_DB=stockflow_test
POSTGRES_USER=stockflow
POSTGRES_PASSWORD=change_me
POSTGRES_TEST_USER=stockflow_test
POSTGRES_TEST_PASSWORD=change_test_password

DATABASE_URL=postgresql+psycopg://stockflow:change_me@127.0.0.1:5433/stockflow
# Disposable test server only; never reuse development credentials.
TEST_DATABASE_URL=postgresql+psycopg://stockflow_test:change_test_password@127.0.0.1:5434/stockflow_test
# STOCKFLOW_ALLOW_TEST_DB_RESET is intentionally absent. Set it in the process
# only after verifying the target and explicitly approving destructive tests.

# Generate two independent random secrets (see README_SETUP.md).
JWT_SECRET_KEY=replace_with_secure_random_key
JWT_ACCESS_EXPIRE_MINUTES=15
# Local HTTP only. Set true with HTTPS in production.
AUTH_COOKIE_SECURE=false
AUTH_SESSION_EXPIRE_DAYS=30
AUTH_ALLOWED_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000","http://localhost:5173","http://127.0.0.1:5173"]
CSRF_SECRET_KEY=your_independent_random_secret

DB_ECHO=false