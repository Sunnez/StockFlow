POSTGRES_DB=stockflow
POSTGRES_TEST_DB=stockflow_test
POSTGRES_USER=stockflow
POSTGRES_PASSWORD=change_me

DATABASE_URL=postgresql+psycopg://stockflow:change_me@127.0.0.1:5433/stockflow
TEST_DATABASE_URL=postgresql+psycopg://stockflow:change_me@127.0.0.1:5434/stockflow_test

JWT_SECRET_KEY=replace_with_secure_random_key
JWT_ACCESS_EXPIRE_MINUTES=15
AUTH_COOKIE_SECURE=true
AUTH_SESSION_EXPIRE_DAYS=30
AUTH_ALLOWED_ORIGINS=["http://localhost:8000","http://localhost:5173"]
CSRF_SECRET_KEY=your_independent_random_secret

DB_ECHO=false